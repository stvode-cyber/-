{
    "name":  "aie-backend",
    "version":  "1.0.6",
    "description":  "绿角犀 - 后端服务 (MVP)",
    "type":  "module",
    "scripts":  {
                    "dev":  "tsx watch src/index.ts",
                    "build":  "tsc",
                    "start":  "node dist/index.js",
                    "prisma:generate":  "prisma generate",
                    "prisma:migrate":  "prisma migrate dev --name init",
                    "prisma:studio":  "prisma studio",
                    "seed":  "tsx prisma/seed.ts",
                    "seed:countdown":  "tsx prisma/seed-countdown.ts",
                    "smoke":  "node smoke-auth.mjs",
                    "smoke:doublespend":  "node smoke-doublespend.mjs",
                    "smoke:asset":  "node smoke-asset-upload.mjs",
                    "smoke:cleanup":  "node smoke-cleanup-devdb.mjs",
                    "smoke:cleanup-orphans":  "node smoke-cleanup-orphan-items.mjs",
                    "smoke:verify":  "node smoke-verify-db.mjs",
                    "smoke:office":  "node smoke-office.mjs",
                    "smoke:p3":  "node smoke-p3-privacy.mjs",
                    "smoke:p4":  "node smoke-p4-config.mjs",
                    "smoke:ab":  "node smoke-ab-stats.mjs"
                },
    "dependencies":  {
                         "@prisma/client":  "^5.22.0",
                         "archiver":  "^8.0.0",
                         "bcryptjs":  "^2.4.3",
                         "cors":  "^2.8.5",
                         "dotenv":  "^16.4.5",
                         "express":  "^4.21.1",
                         "helmet":  "^8.3.0",
                         "jsonwebtoken":  "^9.0.2",
                         "morgan":  "^1.10.0",
                         "zod":  "^3.23.8"
                     },
    "devDependencies":  {
                            "@types/archiver":  "^8.0.0",
                            "@types/bcryptjs":  "^2.4.6",
                            "@types/cors":  "^2.8.17",
                            "@types/express":  "^4.17.21",
                            "@types/jsonwebtoken":  "^9.0.7",
                            "@types/morgan":  "^1.9.9",
                            "@types/node":  "^22.9.0",
                            "prisma":  "^5.22.0",
                            "tsx":  "^4.19.2",
                            "typescript":  "^5.6.3"
                        }
}
