# ============================================
# AI 助理系统 - 后端环境变量模板
# ============================================
# 部署时复制为 .env 并填写真实值：cp .env.example .env

# ---- 应用配置 ----
# 运行端口（默认 3001）
PORT=3001
# 运行环境：development / production（生产环境不暴露错误栈）
NODE_ENV=production

# ---- 安全密钥 ----
# JWT 签名密钥（必填！生产环境必须设置为强随机字符串）
# 生成命令：openssl rand -hex 32
JWT_SECRET=请替换为32位以上的随机字符串
# JWT 过期时间（P2-5 修复：24 小时，配合 Refresh Token 续期）
JWT_EXPIRES_IN=24h

# ---- PII 脱敏密钥 ----
# 身份证号哈希 PEPPER（P2-7 修复：独立于 JWT_SECRET，增强 PII 保护）
# 生成命令：openssl rand -hex 32
# 未设置时 fallback 到 JWT_SECRET 派生（不推荐，生产环境必须独立配置）
ID_CARD_PEPPER=请替换为32位以上的随机字符串

# ---- 数据库 ----
# SQLite 数据库文件路径（默认 ./prisma/dev.db）
DATABASE_URL=file:./prisma/prod.db

# ---- 跨域配置 ----
# 前端访问地址（生产环境填实际域名或 IP）
# 示例：http://123.45.67.89 或 https://example.com
CORS_ORIGIN=http://localhost:5173

# ---- 管理员账号（首次启动种子数据）----
# 仅 seed 脚本执行时使用；#14 修复后 seed 会 upsert 更新密码，故每次跑 seed 都会用此密码覆盖
# ⚠️ 生产环境必须设置为强随机密码（至少 16 位，含大小写字母+数字+符号）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请替换为强随机密码

# ---- LLM 大模型配置（可选）----
# Provider: ollama（本地，隐私优先）| openai（云端兼容 API）| none（禁用）
LLM_PROVIDER=ollama
# 模型名称（ollama: qwen2.5:7b / qwen2.5:3b；openai: deepseek-chat 等）
LLM_MODEL=qwen2.5:7b
# API 地址
LLM_BASE_URL=http://localhost:11434
# API Key（Ollama 不需要；云端必须配置）
# LLM_API_KEY=your-api-key-here
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512
LLM_TIMEOUT=30000
