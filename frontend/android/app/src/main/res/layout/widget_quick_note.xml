<?xml version="1.0" encoding="utf-8"?>
<!--
    随手记主屏小部件布局
    - 圆角卡片样式（corner_radius 16dp，符合 Material Design 风格）
    - 紫蓝渐变背景，与前端 HomePage 随手记卡片配色一致
    - 标题 "随手记" + 副标题 "AI 自动分类" + 提示文字 "点击快速记录…"
    - 整个 widget_root 可点击（点击事件在 QuickNoteWidgetProvider 中绑定）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/widget_quick_note_bg"
    android:padding="14dp"
    android:gravity="center_vertical">

    <!-- 左侧图标：紫色圆角方块 + 笔记 emoji 文字（RemoteViews 不支持 SVG/向量图 emoji，用文字） -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_icon_bg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="✦"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />
    </FrameLayout>

    <!-- 右侧文本区：标题 + 副标题/提示 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_quick_note_title"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_quick_note_hint"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
