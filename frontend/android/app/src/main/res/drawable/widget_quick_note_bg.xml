<?xml version="1.0" encoding="utf-8"?>
<!--
    随手记小部件背景：紫蓝渐变 + 圆角
    与前端 HomePage 随手记卡片配色一致（from-indigo-400 to-purple-500）
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#6366F1"
        android:centerColor="#7C3AED"
        android:endColor="#A855F7"
        android:angle="135" />
    <corners android:radius="16dp" />
    <padding
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp" />
</shape>
